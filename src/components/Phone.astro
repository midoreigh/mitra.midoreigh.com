---
// An Android screenshot in a Galaxy S24 Ultra: flat titanium frame, squarish corners, thin
// even bezels, a centred punch-hole and the side keys on the right. The screenshots have their
// status bar cropped off (it showed real notifications); a clean one is drawn in its place, on
// `bar`, the colours along the top of the screenshot. Without `bar`, the screenshot is shown whole.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  bar?: string;
  widths: number[];
  sizes: string;
  class?: string;
  [attribute: `data-${string}`]: string;
}

const { src, alt, bar, widths, sizes, class: className, ...rest } = Astro.props;
---

<figure class:list={['phone', className]} {...rest}>
  <div class="rim">
    <div class="bezel">
      <div class="display">
        {bar && (
        <div class="status" style={`--bar: ${bar}`} aria-hidden="true">
          <span>12:30</span>
          <i class="camera"></i>
          <svg viewBox="0 0 54 16" fill="currentColor">
            <path d="M7 3.2c2.6 0 5 1 6.8 2.7l-1.4 1.5A7.8 7.8 0 0 0 7 5.2 7.8 7.8 0 0 0 1.6 7.4L.2 5.9A9.8 9.8 0 0 1 7 3.2zm0 4c1.5 0 2.9.6 4 1.6l-1.4 1.5A3.7 3.7 0 0 0 7 9.2c-1 0-1.9.4-2.6 1.1L3 8.8a5.7 5.7 0 0 1 4-1.6zm0 4 1.6 1.6L7 14.4l-1.6-1.6z" />
            <path d="M18 13h2v2h-2zm4-3h2v5h-2zm4-3h2v8h-2zm4-4h2v12h-2z" />
            <rect x="37" y="4" width="14" height="9" rx="2.4" fill="none" stroke="currentColor" stroke-width="1.3" />
            <rect x="39" y="6" width="10" height="5" rx="1.2" />
            <rect x="51.8" y="7" width="1.6" height="3" rx=".8" />
          </svg>
        </div>
        )}
        <Image src={src} alt={alt} widths={widths} sizes={sizes} />
      </div>
    </div>
  </div>
</figure>

<style>
  .phone {
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    margin: 0;
  }
  /* Titanium Black, catching the light on its flat edges. */
  .rim {
    position: relative;
    padding: 1.15cqw;
    border-radius: 6.6cqw;
    background: linear-gradient(145deg, #77797e 0%, #3b3d42 16%, #232428 48%, #393b40 82%, #72747a 100%);
    box-shadow:
      0 50px 100px -30px rgba(0, 0, 0, 0.9),
      inset 0 0 0 0.3cqw rgba(255, 255, 255, 0.18),
      inset 0 0 0 0.7cqw rgba(0, 0, 0, 0.35);
  }
  /* Volume rocker, then the side key. */
  .rim::before {
    content: '';
    position: absolute;
    z-index: -1;
    right: -0.75cqw;
    top: 20%;
    width: 1.4cqw;
    height: 21%;
    border-radius: 0.6cqw;
    background: linear-gradient(
      to bottom,
      #4b4d52 0 46%, transparent 46% 60%, #4b4d52 60% 100%
    );
  }
  .bezel {
    padding: 1.7cqw;
    border-radius: 5.5cqw;
    background: #000;
  }
  .display {
    overflow: hidden;
    border-radius: 3.9cqw;
    background: #000;
  }
  .display :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .status {
    position: relative;
    aspect-ratio: 1440 / 112;
    padding: 0 6.2cqw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bar);
    color: #fff;
    font-size: 3.3cqw;
    font-weight: 600;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .status svg { width: 13cqw; height: auto; }
  .camera {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 3.1cqw;
    height: 3.1cqw;
    translate: -50% -42%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 38%, #1d2230 0 22%, #050608 40%);
    box-shadow: 0 0 0 0.25cqw #0b0c0f;
  }
</style>
